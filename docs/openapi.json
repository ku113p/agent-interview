  "components": {
    "schemas": {
      "ChatRequest": {
        "properties": {
          "user_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]+$",
            "title": "User Id"
          },
          "message": {
            "type": "string",
            "maxLength": 4096,
            "minLength": 1,
            "title": "Message"
          },
          "thread_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]+$",
            "title": "Thread Id",
            "default": "default_thread"
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "message"
        ],
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "response": {
            "type": "string",
            "title": "Response"
          },
          "step_count": {
            "type": "integer",
            "title": "Step Count"
          }
        },
        "type": "object",
        "required": [
          "response",
          "step_count"
        ],
        "title": "ChatResponse"
      },
      "CritiqueSchema": {
        "properties": {
          "is_approved": {
            "type": "boolean",
            "title": "Is Approved"
          },
          "feedback": {
            "type": "string",
            "title": "Feedback"
          },
          "score": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Score"
          }
        },
        "type": "object",
        "required": [
          "is_approved",
          "feedback",
          "score"
        ],
        "title": "CritiqueSchema",
        "description": "Output for the Critic Agent."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PlanSchema": {
        "properties": {
          "goal_analysis": {
            "type": "string",
            "title": "Goal Analysis",
            "description": "Understanding of the user's intent"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/PlanStep"
            },
            "type": "array",
            "title": "Steps",
            "description": "Sequential steps to achieve the goal"
          },
          "missing_info": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Missing Info",
            "description": "Questions to ask the user"
          }
        },
        "type": "object",
        "required": [
          "goal_analysis",
          "steps"
        ],
        "title": "PlanSchema",
        "description": "Output for the Architect Agent."
      },
      "PlanStep": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "in_progress",
              "done"
            ],
            "title": "Status",
            "default": "pending"
          }
        },
        "type": "object",
        "required": [
          "id",
          "description"
        ],
        "title": "PlanStep"
      },
      "Sphere": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id",
            "description": "Unique sphere ID"
          },
          "user_id": {
            "type": "string",
            "format": "uuid",
            "title": "User Id",
            "description": "Owner of this sphere"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name",
            "description": "Sphere name, e.g., 'Career 2010-2015'"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description",
            "description": "Optional description of the sphere"
          },
          "status": {
            "$ref": "#/components/schemas/SphereStatus",
            "description": "Current collection status",
            "default": "not_started"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "name"
        ],
        "title": "Sphere",
        "description": "Domain entity representing a biography topic/sphere.\n\nA Sphere is a focused area of biography collection (e.g., \"Career\", \"Childhood\").\nEach user can have multiple spheres with different statuses."
      },
      "SphereStatus": {
        "type": "string",
        "enum": [
          "not_started",
          "in_progress",
          "completed"
        ],
        "title": "SphereStatus"
      },
      "ThreadStateResponse": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "current_sphere_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Sphere Id"
          },
          "plan": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PlanSchema"
              },
              {
                "type": "null"
              }
            ]
          },
          "critique": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CritiqueSchema"
              },
              {
                "type": "null"
              }
            ]
          },
          "plan_approved": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Plan Approved"
          },
          "step_count": {
            "type": "integer",
            "title": "Step Count"
          },
          "messages": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Messages"
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "step_count"
        ],
        "title": "ThreadStateResponse",
        "description": "DTO for the thread state, hiding internal fields like error_count."
      },
      "UserProfile": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id",
            "description": "Unique aggregate ID"
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "is_active": {
            "type": "boolean",
            "title": "Is Active",
            "default": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "full_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Full Name"
          },
          "profession": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Profession"
          },
          "experience_years": {
            "type": "integer",
            "title": "Experience Years",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "email"
        ],
        "title": "UserProfile",
        "description": "Aggregate Root for the User Context.\nRepresents the 'Truth' of the business logic."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}